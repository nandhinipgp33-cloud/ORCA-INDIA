POSTGRES_DB=orca_india
POSTGRES_USER=orca
POSTGRES_PASSWORD=replace-this-local-password
# Docker Compose host port; set DATABASE_URL to this port when using Compose.
POSTGRES_PORT=5433
# For the local PostgreSQL service, which listens on port 5432 by default.
DATABASE_URL=postgresql+psycopg://orca:replace-this-local-password@127.0.0.1:5432/orca_india
CORS_ORIGINS=["http://127.0.0.1:5173"]
API_HOST=127.0.0.1
API_PORT=8001
